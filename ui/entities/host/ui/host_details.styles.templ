package host_ui

css host_details() {
	display: grid;
	gap: 8px;
}

css host_details_name() {
	margin: 0;
	font-size: 1rem;
	font-weight: 700;
	line-height: 1.2;
}

css host_details_description() {
	margin: 0;
	color: var(--muted);
	font-size: 0.92rem;
	line-height: 1.35;
	min-height: 2.4em;
}

css host_details_tags() {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
}

css host_details_meta() {
	margin: 0;
	padding-top: 8px;
	border-top: 1px solid var(--border);
	display: grid;
	gap: 6px;
}

css host_details_meta_row() {
	margin: 0;
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 8px;
}

css host_details_meta_label() {
	margin: 0;
	color: var(--muted);
	font-size: 0.82rem;
	text-transform: uppercase;
	letter-spacing: 0.03em;
}

css host_details_meta_value() {
	margin: 0;
	font-size: 0.9rem;
	font-weight: 600;
	text-align: right;
}

css host_details_ip_disclosure() {
	display: inline-flex;
	flex-direction: row-reverse;
	align-items: center;
	gap: 10px;
}

css host_details_ip_toggle() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 30px;
	height: 30px;
	padding: 0;
	border: none;
	border-radius: var(--radius-pill);
	color: var(--text);
	background: transparent;
	line-height: 1;
	cursor: pointer;
	user-select: none;
}

css host_details_ip_toggle_icon() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	color: currentColor;
}

css host_details_ip_value() {
	display: inline-flex;
	align-items: center;
	min-width: 9ch;
	min-height: 1.35em;
	padding: 1px 4px;
	border-radius: var(--radius-xs);
	color: var(--text);
	word-break: break-word;
}

css host_details_ip_value_masked() {
	color: transparent;
	text-shadow: var(--shadow-sensitive-text);
	background: var(--surface-sensitive-mask);
	filter: blur(var(--blur-sensitive));
	user-select: none;
}

css host_details_summary() {
	display: flex;
	flex-direction: column;
	gap: 6px;
	margin-bottom: 12px;
}

css host_details_summary_row() {
	margin: 0;
}

css host_system_info_section() {
	display: flex;
	flex-direction: column;
	gap: 8px;
	margin-bottom: 12px;
}

css host_system_info_title() {
	margin: 0;
	font-size: 1rem;
}

css host_system_info_empty() {
	margin: 0;
	color: var(--muted);
	font-size: 0.9rem;
}

css host_system_info_grid() {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
	gap: 8px;
}

css host_system_info_item() {
	display: flex;
	flex-direction: column;
	gap: 4px;
	padding: 8px;
	border: 1px solid var(--border);
	border-radius: var(--radius-sm);
	background: var(--surface-overlay-muted);
}

css host_system_info_item_full_width() {
	grid-column: 1 / -1;
}

css host_system_info_label() {
	font-size: 0.78rem;
	color: var(--muted);
}

css host_system_info_value() {
	font-size: 0.9rem;
	color: var(--text);
	word-break: break-word;
}
