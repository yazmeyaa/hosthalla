package dashboard_ui

import "strconv"

type DashboardOverviewProps struct {
	TotalHosts          int
	ReportingHosts      int
	StaleHosts          int
	WaitingHosts        int
	MonitoredHosts      int
	SystemInfoHosts     int
	ManagementMethods   int
	LatestMetricAtLabel string
}

templ DashboardOverview(props DashboardOverviewProps) {
	<section class={ dashboard_overview() }>
		<div class={ dashboard_overview_primary() }>
			@metricCard("Hosts", props.TotalHosts, "Registered inventory", "total")
			@metricCard("Reporting", props.ReportingHosts, "Fresh metrics", "success")
			@metricCard("Stale", props.StaleHosts, "Older than 2 minutes", "warning")
			@metricCard("Waiting", props.WaitingHosts, "No metric snapshot", "neutral")
		</div>
		<div class={ dashboard_overview_secondary() } aria-label="Dashboard secondary metrics">
			@compactMetric("Agents", formatInt(props.MonitoredHosts))
			@compactMetric("Systems", formatInt(props.SystemInfoHosts))
			@compactMetric("Access", formatInt(props.ManagementMethods))
			@compactMetric("Latest metric", props.LatestMetricAtLabel)
		</div>
	</section>
}

templ metricCard(label string, value int, hint string, variant string) {
	<div class={ dashboard_overview_card(), overviewMetricVariantClass(variant) }>
		<div class={ dashboard_overview_tile() }>
			<span class={ dashboard_overview_label() }>{ label }</span>
			<strong class={ dashboard_overview_value() }>{ formatInt(value) }</strong>
			<span class={ dashboard_overview_hint() }>{ hint }</span>
		</div>
	</div>
}

templ compactMetric(label string, value string) {
	<div class={ dashboard_overview_compact_metric() }>
		<span class={ dashboard_overview_label() }>{ label }</span>
		<strong class={ dashboard_overview_value_text() }>{ value }</strong>
	</div>
}

func formatInt(value int) string {
	return strconv.Itoa(value)
}

func overviewMetricVariantClass(variant string) string {
	switch variant {
	case "success":
		return dashboard_overview_card_success().ClassName()
	case "warning":
		return dashboard_overview_card_warning().ClassName()
	case "neutral":
		return dashboard_overview_card_neutral().ClassName()
	default:
		return dashboard_overview_card_total().ClassName()
	}
}
