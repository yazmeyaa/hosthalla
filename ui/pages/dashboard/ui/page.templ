package dashboard_ui

import (
	"github.com/yazmeyaa/hosthalla/ui/app/layout"
	"github.com/yazmeyaa/hosthalla/ui/entities/host_details"
	dashboard_hosts "github.com/yazmeyaa/hosthalla/ui/widgets/dashboard_hosts"
	dashboard_overview "github.com/yazmeyaa/hosthalla/ui/widgets/dashboard_overview"
)

type DashboardData struct {
	GeneratedAtLabel string
	Summary          DashboardSummary
	Hosts            []DashboardHostRow
}

type DashboardSummary struct {
	TotalHosts          int
	ReportingHosts      int
	StaleHosts          int
	WaitingHosts        int
	MonitoredHosts      int
	SystemInfoHosts     int
	ManagementMethods   int
	LatestMetricAtLabel string
}

type DashboardHostRow = dashboard_hosts.HostRow

type DashboardPageProps struct {
	Data            DashboardData
	AuthLayoutProps layout.AuthenticatedLayoutProps
}

templ DashboardPage(props DashboardPageProps) {
	@layout.AuthenticatedLayout(props.AuthLayoutProps) {
		@DashboardPageContent(props)
	}
}

templ DashboardPageContent(props DashboardPageProps) {
	<div class={ dashboard_page_shell() } ws-connect="/dashboard/subscribe">
		<header class={ dashboard_page_header() }>
			<div class={ dashboard_page_heading() }>
				<h1 class={ dashboard_page_title() }>Dashboard</h1>
				@DashboardGeneratedAtMeta(props.Data.GeneratedAtLabel)
			</div>
			<a class={ dashboard_page_refresh_link() } href="/dashboard">Refresh</a>
		</header>
		@DashboardOverviewSection(props.Data)
		@DashboardHostsSection(props.Data)
		@host_details.HostDetailsScripts()
	</div>
}

templ DashboardGeneratedAtMeta(generatedAtLabel string) {
	<p id="dashboard-generated-at" class={ dashboard_page_meta() }>Cached snapshot generated at { generatedAtLabel }</p>
}

templ DashboardOverviewSection(data DashboardData) {
	<div id="dashboard-overview">
		@DashboardOverviewContent(data)
	</div>
}

templ DashboardHostsSection(data DashboardData) {
	<div id="dashboard-hosts">
		@DashboardHostsContent(data)
	</div>
}

templ DashboardLiveUpdate(data DashboardData) {
	<p id="dashboard-generated-at" class={ dashboard_page_meta() } hx-swap-oob="outerHTML">Cached snapshot generated at { data.GeneratedAtLabel }</p>
	<div id="dashboard-overview" hx-swap-oob="outerHTML">
		@DashboardOverviewContent(data)
	</div>
	<div id="dashboard-hosts" hx-swap-oob="outerHTML">
		@DashboardHostsContent(data)
	</div>
}

templ DashboardOverviewContent(data DashboardData) {
	@dashboard_overview.DashboardOverview(dashboard_overview.DashboardOverviewProps{
		TotalHosts:          data.Summary.TotalHosts,
		ReportingHosts:      data.Summary.ReportingHosts,
		StaleHosts:          data.Summary.StaleHosts,
		WaitingHosts:        data.Summary.WaitingHosts,
		MonitoredHosts:      data.Summary.MonitoredHosts,
		SystemInfoHosts:     data.Summary.SystemInfoHosts,
		ManagementMethods:   data.Summary.ManagementMethods,
		LatestMetricAtLabel: data.Summary.LatestMetricAtLabel,
	})
}

templ DashboardHostsContent(data DashboardData) {
	@dashboard_hosts.DashboardHosts(dashboard_hosts.DashboardHostsProps{
		Hosts: data.Hosts,
	})
}
