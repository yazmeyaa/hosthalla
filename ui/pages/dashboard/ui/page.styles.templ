package dashboard_ui

func CSSClasses() []templ.CSSClass {
	return []templ.CSSClass{
		dashboard_page_shell(),
		dashboard_page_header(),
		dashboard_page_heading(),
		dashboard_page_title(),
		dashboard_page_meta(),
		dashboard_page_refresh_link(),
		dashboard_overview(),
		dashboard_overview_card(),
		dashboard_overview_label(),
		dashboard_overview_value(),
		dashboard_overview_value_text(),
		dashboard_overview_hint(),
		dashboard_hosts(),
		dashboard_hosts_header(),
		dashboard_hosts_title(),
		dashboard_hosts_count(),
		dashboard_hosts_empty(),
		dashboard_hosts_list(),
		dashboard_hosts_item(),
		dashboard_hosts_item_header(),
		dashboard_hosts_identity(),
		dashboard_hosts_name(),
		dashboard_hosts_ip(),
		dashboard_hosts_ip_disclosure(),
		dashboard_hosts_ip_toggle(),
		dashboard_hosts_ip_toggle_icon(),
		dashboard_hosts_ip_masked(),
		dashboard_hosts_meta(),
		dashboard_hosts_metrics(),
		dashboard_hosts_metric(),
		dashboard_hosts_metric_summary(),
		dashboard_hosts_metric_label(),
		dashboard_hosts_metric_compact_value(),
		dashboard_hosts_metric_value(),
		dashboard_hosts_sparkline_shell(),
		dashboard_hosts_sparkline_scale(),
		dashboard_hosts_sparkline(),
		dashboard_hosts_sparkline_cpu(),
		dashboard_hosts_sparkline_memory(),
		dashboard_hosts_sparkline_rule(),
		dashboard_hosts_sparkline_mid_rule(),
		dashboard_hosts_sparkline_line(),
		dashboard_hosts_tags(),
	}
}

css dashboard_page_shell() {
	display: flex;
	flex-direction: column;
	gap: 14px;
}

css dashboard_page_header() {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 12px;
	padding-inline: 12px;
}

css dashboard_page_heading() {
	display: flex;
	flex-direction: column;
	gap: 4px;
}

css dashboard_page_title() {
	margin: 0;
}

css dashboard_page_meta() {
	margin: 0;
	color: var(--muted);
	font-size: 0.86rem;
}

css dashboard_page_refresh_link() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-height: 34px;
	padding: 0.45rem 0.7rem;
	border: 1px solid var(--border);
	border-radius: var(--radius-md);
	color: var(--text);
	background: transparent;
	text-decoration: none;
	font-size: 0.9rem;
	font-weight: 600;
	transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, transform 120ms ease, box-shadow 180ms ease;
}
