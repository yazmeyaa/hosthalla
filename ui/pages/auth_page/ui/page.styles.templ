package auth_page_ui

css auth_page_wrapper() {
	min-height: calc(100vh - 24px);
	display: flex;
	align-items: center;
	justify-content: center;
}

css auth_card_content() {
	width: 100%;
	max-width: 420px;
	display: flex;
	flex-direction: column;
	gap: 14px;
}

css auth_title() {
	margin: 0;
	font-size: 1.75rem;
	line-height: 1.2;
}

css auth_subtitle() {
	margin: 0;
	color: var(--muted);
	font-size: 0.95rem;
}

css auth_form() {
	display: flex;
	flex-direction: column;
	gap: 12px;
}

css auth_field() {
	display: flex;
	flex-direction: column;
	gap: 6px;
}

css auth_label() {
	font-size: 0.9rem;
	color: var(--muted);
}

css auth_footer_text() {
	margin: 0;
	color: var(--muted);
	font-size: 0.85rem;
	text-align: center;
}
