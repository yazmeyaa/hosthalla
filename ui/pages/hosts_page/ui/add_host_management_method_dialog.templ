package hosts_page_ui

import (
	"github.com/yazmeyaa/hosthalla/internal/host"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/button"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/input"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/modal"
)

templ AddHostManagementMethodDialog(host host.Host, dialogID string, open bool) {
	@modal.Modal(modal.ModalProps{ID: dialogID, AriaLabel: "Add management method", Open: open, CloseHref: "/hosts/" + host.ID.String()}) {
		@modal.Content() {
			@modal.Title("Add Management Method")
			<form class={ host_form(), host_management_method_form(), "host-management-method-form" } method="post" action={ "/hosts/" + host.ID.String() + "/management-methods/create" }>
				<div class={ host_form_field() }>
					<label class={ host_form_label() } for={ "management-method-type-" + host.ID.String() }>Type</label>
					<select
						class={ host_management_method_select(), "ui-input", "host-management-method-type-select" }
						id={ "management-method-type-" + host.ID.String() }
						name="methodType"
						hx-get={ "/hosts/" + host.ID.String() + "/management-method-fields" }
						hx-trigger="change"
						hx-target={ "#management-method-auth-fields-" + host.ID.String() }
						hx-swap="outerHTML"
					>
						<option value="ssh_password">SSH (Username + Password)</option>
						<option value="ssh_key">SSH (Private Key)</option>
					</select>
				</div>
				<div class={ host_form_field() }>
					<label class={ host_form_label() } for={ "management-method-name-" + host.ID.String() }>Name</label>
					@input.Input(input.InputProps{Id: "management-method-name-" + host.ID.String(), Name: "name", Required: true})
				</div>
				<div class={ host_form_field() }>
					<label class={ host_form_label() } for={ "management-method-description-" + host.ID.String() }>Description (optional)</label>
					@input.Input(input.InputProps{Id: "management-method-description-" + host.ID.String(), Name: "description"})
				</div>
				<div class={ host_form_field() } data-method-field="username">
					<label class={ host_form_label() } for={ "management-method-username-" + host.ID.String() }>Username</label>
					@input.Input(input.InputProps{Id: "management-method-username-" + host.ID.String(), Name: "username", ClassName: "ui-mono-text", Required: true})
				</div>
				<div class={ host_form_field() }>
					<label class={ host_form_label() } for={ "management-method-port-" + host.ID.String() }>Port</label>
					@input.Input(input.InputProps{Id: "management-method-port-" + host.ID.String(), Name: "port", Type: "number", Value: "22", ClassName: "ui-mono-text"})
				</div>
				@AddHostManagementMethodFields(host.ID.String(), "ssh_password")
				@modal.Actions() {
					@button.Link(button.LinkProps{Href: "/hosts/" + host.ID.String(), Variant: "secondary"}) {
						Cancel
					}
					@button.Button(button.ButtonProps{Type: "submit"}) {
						Add
					}
				}
			</form>
		}
	}
}

templ AddHostManagementMethodFields(hostID string, methodType string) {
	<div id={ "management-method-auth-fields-" + hostID }>
		if methodType == "ssh_key" {
			<div class={ host_management_method_auth_section(), host_management_method_key_fields() }>
				<div class={ host_form_field() } data-method-field="publicKey">
					<label class={ host_form_label() } for={ "management-method-public-key-" + hostID }>Public Key</label>
					<textarea class={ host_management_method_textarea(), "ui-input", "ui-mono-text" } id={ "management-method-public-key-" + hostID } name="publicKey" rows="4" required></textarea>
				</div>
				<div class={ host_form_field() } data-method-field="privateKey">
					<label class={ host_form_label() } for={ "management-method-private-key-" + hostID }>Private Key</label>
					<textarea class={ host_management_method_textarea(), "ui-input", "ui-mono-text" } id={ "management-method-private-key-" + hostID } name="privateKey" rows="7" required></textarea>
				</div>
			</div>
		} else {
			<div class={ host_management_method_auth_section() }>
				<div class={ host_form_field() } data-method-field="password">
					<label class={ host_form_label() } for={ "management-method-password-" + hostID }>Password</label>
					@input.Input(input.InputProps{Id: "management-method-password-" + hostID, Name: "password", Type: "password", Required: true})
				</div>
			</div>
		}
	</div>
}
