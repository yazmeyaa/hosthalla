package hosts_page_ui

css host_actions() {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	gap: 8px;
}

css host_ping_form() {
	margin: 0;
	display: grid;
	width: 100%;
}

css host_delete_form() {
	margin: 0;
	display: grid;
}

css host_actions_menu() {
	position: relative;
}

css host_actions_menu_trigger() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	list-style: none;
	width: 34px;
	height: 32px;
	border-radius: var(--radius-sm);
	border: 1px solid var(--border);
	background: transparent;
	color: var(--text);
	cursor: pointer;
	user-select: none;
	font-size: 1rem;
	font-weight: 600;
	line-height: 1;
}

css host_actions_menu_panel() {
	position: absolute;
	right: 0;
	top: calc(100% + var(--space-6));
	z-index: 100;
	min-width: 168px;
	padding: var(--space-8);
	border: 1px solid rgba(148, 163, 184, 0.22);
	border-radius: var(--radius-lg);
	background: #07111f;
	box-shadow: var(--shadow-overlay);
	display: grid;
	justify-items: stretch;
	gap: var(--space-6);
}

css host_ping_result() {
	margin: 0;
	font-size: 0.8rem;
	line-height: 1.35;
	overflow-wrap: anywhere;
}

css host_ping_result_placeholder() {
	color: var(--muted);
}

css host_ping_result_success() {
	color: var(--text-success-soft);
}

css host_ping_result_error() {
	color: var(--text-danger-soft);
}

css host_ping_all_status() {
	margin: 0;
	font-size: 0.88rem;
	color: var(--muted);
}
