package hosts_page_ui

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/yazmeyaa/hosthalla/internal/host"
	host_entity "github.com/yazmeyaa/hosthalla/ui/entities/host"
	hosts_page_model "github.com/yazmeyaa/hosthalla/ui/pages/hosts_page/model"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/button"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/dropdown"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/layout"
)

type HostsPageProps struct {
	Hosts                         []host.Host
	TotalHosts                    int
	AvailableTags                 []host.Tag
	AvailableManagementFilters    []string
	SearchQuery                   string
	SelectedTags                  []string
	SelectedStatuses              []string
	SelectedManagementFilters     []string
	SortKey                       string
	SortDirection                 string
	HostManagementMethodsByHostID map[string][]host.HostManagementMethod
	HostSystemInfoByHostID        map[string]host.HostSystemInfo
	HostLatestMetricsByHostID     map[string]hosts_page_model.HostLatestMetricsBadges
	AuthLayoutProps               layout.AuthenticatedLayoutProps
}

templ HostsPage(props HostsPageProps) {
	@layout.AuthenticatedLayout(props.AuthLayoutProps) {
		@HostsPageContent(props)
	}
}

templ HostsPageContent(props HostsPageProps) {
	@dropdown.Styles()
	<div class={ hosts_page_header() }>
		<h1 class={ hosts_page_title() }>
			Hosts <span class={ hosts_page_title_count() }>{ "· " + hostCountLabel(props.TotalHosts) }</span>
		</h1>
		<div class={ hosts_page_actions() }>
			@dropdown.Menu("Import / Export") {
				@dropdown.LinkItem(dropdown.LinkItemProps{
					Href:  "/hosts/export",
					Label: "Export hosts",
				})
				@dropdown.ButtonItem(dropdown.ButtonItemProps{
					Label:       "Import JSON",
					Description: "Preview first, duplicate IPs are skipped",
					OnClick:     templ.JSFuncCall("openModalDialog", "hosts-import-export-dialog"),
				})
			}
			<form
				class={ hosts_page_ping_all_form() }
				method="post"
				action="/hosts/ping-all"
				hx-post="/hosts/ping-all"
				hx-target="#hosts-ping-all-status"
				hx-swap="outerHTML"
			>
				@button.Button(button.ButtonProps{Type: "submit", Variant: "secondary"}) {
					Ping All
				}
			</form>
			@button.Button(button.ButtonProps{Type: "button", OnClick: templ.JSFuncCall("openModalDialog", "create-host-dialog")}) {
				Add Host
			}
		</div>
	</div>
	<div id="hosts-ping-all-status" class={ hosts_page_ping_all_status_slot() }></div>
	@HostsInventory(props)
	@CreateHostDialog(props.AvailableTags)
	@HostImportExportDialog(props.Hosts)
	<div
		id="host-modal-root"
		data-host-management-method-form-class={ host_management_method_form().ClassName() }
		data-host-management-method-select-class={ host_management_method_select().ClassName() }
		data-host-management-method-textarea-class={ host_management_method_textarea().ClassName() }
		data-host-management-method-key-fields-class={ host_management_method_key_fields().ClassName() }
	></div>
	@HostsInventoryScripts()
	@HostActionsScripts()
	@HostDialogScripts()
	@host_entity.HostDetailsScripts()
	@dropdown.Scripts()
}

func hostCountLabel(count int) string {
	return fmt.Sprintf("%d", count)
}

func hostTagSelected(tag string, selectedTags []string) bool {
	normalizedTag := strings.ToLower(strings.TrimSpace(tag))
	for _, selectedTag := range selectedTags {
		if strings.ToLower(strings.TrimSpace(selectedTag)) == normalizedTag {
			return true
		}
	}
	return false
}

func hostTagFilterHref(tag string, props HostsPageProps) string {
	query := hostsPageQuery(props)
	query.Del("tag")
	shouldAdd := true
	for _, selectedTag := range props.SelectedTags {
		if selectedTag == tag {
			shouldAdd = false
			continue
		}
		query.Add("tag", selectedTag)
	}
	if shouldAdd {
		query.Add("tag", tag)
	}
	return hostsURL(query)
}

func hostsPageQuery(props HostsPageProps) url.Values {
	query := url.Values{}
	if props.SearchQuery != "" {
		query.Set("q", props.SearchQuery)
	}
	for _, status := range props.SelectedStatuses {
		query.Add("status", status)
	}
	for _, tag := range props.SelectedTags {
		query.Add("tag", tag)
	}
	for _, method := range props.SelectedManagementFilters {
		query.Add("management", method)
	}
	if props.SortKey != "" {
		query.Set("sort", props.SortKey)
	}
	if props.SortDirection != "" {
		query.Set("direction", props.SortDirection)
	}
	return query
}

func hostsURL(query url.Values) string {
	if len(query) == 0 {
		return "/hosts"
	}
	return "/hosts?" + query.Encode()
}

func hostsSortHref(props HostsPageProps, sortKey string) string {
	query := hostsPageQuery(props)
	direction := "asc"
	if props.SortKey == sortKey && props.SortDirection == "asc" {
		direction = "desc"
	}
	query.Set("sort", sortKey)
	query.Set("direction", direction)
	return hostsURL(query)
}

func hostsPageQueryWithout(props HostsPageProps, key string) url.Values {
	query := hostsPageQuery(props)
	query.Del(key)
	return query
}

func sortIndicator(props HostsPageProps, sortKey string) string {
	if props.SortKey != sortKey {
		return "↕"
	}
	if props.SortDirection == "desc" {
		return "↓"
	}
	return "↑"
}

func hostsFiltersActive(props HostsPageProps) bool {
	return props.SearchQuery != "" ||
		len(props.SelectedStatuses) > 0 ||
		len(props.SelectedTags) > 0 ||
		len(props.SelectedManagementFilters) > 0
}
