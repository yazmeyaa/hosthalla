package hosts_page_ui

import "github.com/yazmeyaa/hosthalla/ui/shared/ui/button"

templ HostActions(hostID string, pingResultTargetID string) {
	<div class={ host_actions() }>
		<details class={ host_actions_menu(), "host-actions-menu" }>
			<summary class={ host_actions_menu_trigger(), "ui-interactive-control" } aria-label="Host actions">⋯</summary>
			<div class={ host_actions_menu_panel() }>
				<form
					class={ host_ping_form() }
					method="post"
					action={ "/hosts/" + hostID + "/ping?target=" + pingResultTargetID }
					hx-post={ "/hosts/" + hostID + "/ping?target=" + pingResultTargetID }
					hx-target={ "#" + pingResultTargetID }
					hx-swap="outerHTML"
					data-host-ping-form
				>
					@button.Button(button.ButtonProps{Type: "submit", Variant: "secondary"}) {
						Ping
					}
				</form>
				<span hx-boost="true" hx-target="#app-content" hx-select="#app-content" hx-swap="outerHTML show:none" hx-push-url="true">
					@button.Link(button.LinkProps{Href: "/hosts/" + hostID, Variant: "secondary"}) {
						Details
					}
				</span>
				<span hx-boost="true" hx-target="#app-content" hx-select="#app-content" hx-swap="outerHTML show:none" hx-push-url="true">
					@button.Link(button.LinkProps{Href: "/hosts/" + hostID + "/update", Variant: "secondary"}) {
						Update
					}
				</span>
				<form class={ host_delete_form() } method="post" action={ "/hosts/" + hostID + "/delete" } onsubmit="return confirm('Delete this host?')">
					@button.Button(button.ButtonProps{Type: "submit", Variant: "danger"}) {
						Delete
					}
				</form>
			</div>
		</details>
	</div>
}
