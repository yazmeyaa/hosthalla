package hosts_page_ui

import (
	"strconv"

	"github.com/yazmeyaa/hosthalla/internal/host"
	host_entity "github.com/yazmeyaa/hosthalla/ui/entities/host"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/button"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/icons"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/modal"
)

func hostManagementMethodDetailsTypeLabel(methodType host.HostManagementMethodType) string {
	switch methodType {
	case host.HostManagementMethodTypeSSHPassword:
		return "SSH (password)"
	case host.HostManagementMethodTypeSSHKey:
		return "SSH (private key)"
	default:
		return string(methodType)
	}
}

templ HostManagementMethodDetailsDialog(hostIP string, method host.HostManagementMethod, dialogID string, updateDialogID string, open bool) {
	{{
		descriptionValue := method.Description
		if descriptionValue == "" {
			descriptionValue = "Not provided"
		}
		nameValue := method.Name
		if nameValue == "" {
			nameValue = hostManagementMethodDetailsTypeLabel(method.Type)
		}

		passwordValue := "Hidden for security reasons"

		authenticationTypeLabel := hostManagementMethodDetailsTypeLabel(method.Type)
		secretLabel := "Password"
		if method.Type == host.HostManagementMethodTypeSSHKey {
			secretLabel = "Private Key"
		}
		secretValueID := "management-method-secret-value-" + method.ID.String()
		secretStatusID := "management-method-secret-status-" + method.ID.String()
		sshCheckStatusID := "management-method-ssh-check-status-" + method.ID.String()
	}}
	@modal.Modal(modal.ModalProps{ID: dialogID, AriaLabel: "Management method details", Open: open, CloseHref: "/hosts/" + method.HostID.String()}) {
		@modal.Content() {
			<div class={ host_management_method_details_header() }>
				<h3 class={ host_management_method_details_title() }>Connection Details</h3>
				<form
					method="post"
					action={ "/hosts/" + method.HostID.String() + "/management-methods/" + method.ID.String() + "/delete" }
					hx-post={ "/hosts/" + method.HostID.String() + "/management-methods/" + method.ID.String() + "/delete" }
					hx-confirm="Delete this authorization method?"
					hx-target="#app-content"
					hx-select="#app-content"
					hx-swap="outerHTML show:none"
					hx-push-url="true"
					data-delete-management-method-form
				>
					<button class={ host_management_method_delete_button(), "ui-interactive-control" } type="submit" aria-label={ "Delete " + nameValue } title="Delete method" data-delete-management-method-button>
						@icons.TrashIcon()
					</button>
				</form>
			</div>
			<div
				hidden
				data-copy-source="host-management-method"
				data-name={ nameValue }
				data-description={ descriptionValue }
				data-authentication-type={ authenticationTypeLabel }
				data-ip={ hostIP }
				data-port={ strconv.Itoa(int(method.Port)) }
				data-user={ method.Username }
				data-password={ passwordValue }
				data-secret-label={ secretLabel }
				data-secret-value=""
			></div>
			<div class={ host_management_method_details_list() }>
				<div class={ host_management_method_details_row() }>
					<span class={ host_management_method_details_label() }>Name</span>
					<span class={ host_management_method_details_value() }>{ nameValue }</span>
				</div>
				<div class={ host_management_method_details_row() }>
					<span class={ host_management_method_details_label() }>Type</span>
					<span class={ host_management_method_details_value() }>
						@host_entity.MethodTypeTag(method.Type)
					</span>
				</div>
				<div class={ host_management_method_details_row() }>
					<span class={ host_management_method_details_label() }>IP</span>
					<span class={ host_management_method_details_value(), "ui-mono-text" }>{ hostIP }</span>
				</div>
				<div class={ host_management_method_details_row() }>
					<span class={ host_management_method_details_label() }>Username</span>
					<span class={ host_management_method_details_value(), "ui-mono-text" }>{ method.Username }</span>
				</div>
				<div class={ host_management_method_details_row() }>
					<span class={ host_management_method_details_label() }>Port</span>
					<span class={ host_management_method_details_value(), "ui-mono-text" }>{ method.Port }</span>
				</div>
				<div class={ host_management_method_details_row() }>
					<span class={ host_management_method_details_label() }>Description</span>
					<span class={ host_management_method_details_value() }>{ descriptionValue }</span>
				</div>
			</div>
			<div class={ host_management_method_secret_section() }>
				<div class={ host_management_method_details_row() }>
					<span class={ host_management_method_details_label() }>{ secretLabel }</span>
					<textarea
						id={ secretValueID }
						class={ host_management_method_secret_value(), "ui-input" }
						rows="5"
						readonly
						data-management-method-secret-value
						data-host-id={ method.HostID.String() }
						data-method-id={ method.ID.String() }
					>Secret is hidden. Reveal it when you need to connect.</textarea>
				</div>
				<p id={ secretStatusID } class={ host_management_method_secret_status() } data-management-method-secret-status></p>
				<p id={ sshCheckStatusID } class={ host_management_method_secret_status() } data-management-method-ssh-check-status></p>
			</div>
			@modal.Actions() {
				@button.Button(button.ButtonProps{Type: "button", Variant: "secondary", OnClick: templ.JSFuncCall("testHostManagementMethodSSH", dialogID)}) {
					Test SSH
				}
				@button.Button(button.ButtonProps{Type: "button", Variant: "secondary", OnClick: templ.JSFuncCall("revealHostManagementMethodSecret", dialogID)}) {
					Reveal Secret
				}
				@button.Button(button.ButtonProps{Type: "button", Variant: "secondary", OnClick: templ.JSFuncCall("copyHostManagementMethodDetails", dialogID)}) {
					Copy Details
				}
				<span hx-boost="true" hx-target="#app-content" hx-select="#app-content" hx-swap="outerHTML show:none" hx-push-url="true">
					@button.Link(button.LinkProps{Href: "/hosts/" + method.HostID.String() + "/methods/" + method.ID.String() + "/update", Variant: "secondary"}) {
						Edit
					}
				</span>
				@button.Link(button.LinkProps{Href: "/hosts/" + method.HostID.String(), Variant: "secondary"}) {
					Close
				}
			}
		}
	}
}
