package callout

type CalloutProps struct {
	Variant string
}

templ Callout(props CalloutProps) {
	<div class={ callout_base(), calloutVariantClass(props.Variant) } role={ calloutRole(props.Variant) }>
		<span class={ callout_icon() } aria-hidden="true">
			@CalloutIcon(props.Variant)
		</span>
		<div class={ callout_content() }>
			{ children... }
		</div>
	</div>
}

templ CalloutIcon(variant string) {
	switch variant {
		case "warning":
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M12 3L22 20H2L12 3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
				<path d="M12 9V13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
				<path d="M12 17H12.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
			</svg>
		default:
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z" stroke="currentColor" stroke-width="1.7"></path>
				<path d="M12 10V17" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
				<path d="M12 7H12.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
			</svg>
	}
}

func calloutVariantClass(variant string) templ.CSSClass {
	switch variant {
	case "warning":
		return callout_warning()
	default:
		return callout_info()
	}
}

func calloutRole(variant string) string {
	if variant == "warning" {
		return "alert"
	}
	return "note"
}
