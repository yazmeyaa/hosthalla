package layout

import (
	"net/url"

	"github.com/yazmeyaa/hosthalla/internal/version"
	"github.com/yazmeyaa/hosthalla/ui/shared/ui/icons"
)

type GenericLayoutProps struct {
	Title         string
	Description   string
	WebOrigin     string
	CanonicalPath string
}

templ GenericLayout(props GenericLayoutProps) {
	<!DOCTYPE html>
	<html lang="en" prefix="og: https://ogp.me/ns#">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="dark light"/>
			<title>{ props.Title }</title>
			<meta name="description" content={ props.Description }/>
			<link rel="canonical" href={ props.WebOrigin + props.CanonicalPath }/>
			<meta property="og:title" content={ props.Title }/>
			<meta property="og:description" content={ props.Description }/>
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content="Hosthalla"/>
			<meta property="og:url" content={ props.WebOrigin + props.CanonicalPath }/>
			<meta property="og:image" content={ props.WebOrigin + "/assets/static/og-preview.png" }/>
			<meta property="og:image:type" content="image/png"/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:image:alt" content="Hosthalla infrastructure dashboard"/>
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ props.Title }/>
			<meta name="twitter:description" content={ props.Description }/>
			<meta name="twitter:image" content={ props.WebOrigin + "/assets/static/og-preview.png" }/>
			<meta name="twitter:image:alt" content="Hosthalla infrastructure dashboard"/>
			<link rel="icon" href={ assetURL("/assets/favicon.svg") } type="image/svg+xml" sizes="any"/>
			@ThemeBootScript()
			<script defer src={ assetURL("/assets/htmx.min.js") }></script>
			<script defer src={ assetURL("/assets/htmx-ext-ws.min.js") }></script>
			@layout_styles()
			<link rel="stylesheet" href={ assetURL("/styles/templ.css") }/>
		</head>
		<body hx-ext="ws" class={ generic_layout_styles() }>
			@icons.EyeIconSymbols()
			@icons.TrashIconSymbols()
			{ children... }
			<footer class={ generic_layout_footer() }>
				<div class={ generic_layout_footer_inner() }>
					<span class={ generic_layout_footer_brand() }>Hosthalla</span>
					<span class={ generic_layout_footer_version() }>{ version.TagString() }</span>
					<span>by yazmeyaa</span>
					<a class={ generic_layout_footer_link() } href="https://github.com/yazmeyaa/hosthalla" target="_blank" rel="noopener noreferrer">GitHub</a>
				</div>
			</footer>
		</body>
	</html>
}

func assetURL(path string) string {
	return path + "?v=" + url.QueryEscape(version.VersionString()+"+"+version.BuildAt)
}

templ ThemeBootScript() {
	<script>
		(function() {
			const key = "hosthalla-theme";
			const media = window.matchMedia ? window.matchMedia("(prefers-color-scheme: light)") : null;
			const root = document.documentElement;

			function storedMode() {
				try {
					const mode = localStorage.getItem(key);
					return mode === "dark" || mode === "light" || mode === "system" ? mode : "system";
				} catch (_) {
					return "system";
				}
			}

			function resolvedTheme(mode) {
				return mode === "dark" || mode === "light" ? mode : (media && media.matches ? "light" : "dark");
			}

			function applyTheme(mode) {
				const nextMode = mode === "dark" || mode === "light" || mode === "system" ? mode : "system";
				const theme = resolvedTheme(nextMode);

				root.dataset.theme = theme;
				root.dataset.themeMode = nextMode;
				root.style.colorScheme = theme;
				document.querySelectorAll("[data-theme-toggle]").forEach(function(toggle) {
					const activeClass = toggle.getAttribute("data-theme-active-class");
					toggle.querySelectorAll("[data-theme-choice]").forEach(function(button) {
						const active = button.getAttribute("data-theme-choice") === nextMode;
						button.setAttribute("aria-pressed", String(active));
						if (activeClass) {
							button.classList.toggle(activeClass, active);
						}
					});
				});
			}

			window.hosthallaTheme = {
				get: storedMode,
				set: function(mode) {
					const nextMode = mode === "dark" || mode === "light" || mode === "system" ? mode : "system";
					try {
						localStorage.setItem(key, nextMode);
					} catch (_) {}
					applyTheme(nextMode);
				},
				refresh: function() {
					applyTheme(storedMode());
				},
			};

			applyTheme(storedMode());

			if (media && media.addEventListener) {
				media.addEventListener("change", function() {
					if (storedMode() === "system") {
						applyTheme("system");
					}
				});
			}

			window.addEventListener("storage", function(event) {
				if (event.key === key) {
					applyTheme(storedMode());
				}
			});
		})();
	</script>
}

templ AppContent() {
	<main id="app-content" class={ generic_layout_main() }>
		{ children... }
	</main>
}
