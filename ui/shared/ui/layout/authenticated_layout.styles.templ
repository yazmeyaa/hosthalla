package layout

css authenticated_shell() {
	display: flex;
	flex-direction: column;
	gap: 20px;
}

css authenticated_header() {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 14px;
	padding: 12px 14px;
	border: 1px solid var(--border);
	border-radius: var(--radius-xl);
	background: var(--surface-header-gradient);
	box-shadow: 0 14px 36px rgba(2, 6, 23, 0.18);
	position: relative;
	overflow: hidden;
}

css authenticated_header_motif() {
	position: absolute;
	inset: 0;
	pointer-events: none;
	background:
		linear-gradient(135deg, transparent 0 46%, rgba(34, 211, 238, 0.08) 46% 48%, transparent 48% 100%),
		linear-gradient(45deg, transparent 0 56%, rgba(34, 211, 238, 0.045) 56% 58%, transparent 58% 100%);
	mask-image: linear-gradient(90deg, transparent, #000 22%, transparent 72%);
}

css authenticated_brand() {
	display: flex;
	align-items: center;
	gap: 10px;
	min-width: 180px;
}

css authenticated_brand_mark() {
	display: inline-grid;
	place-items: center;
	width: 34px;
	height: 34px;
	border: 1px solid var(--border-interactive-info);
	border-radius: 8px 3px 8px 3px;
	background: rgba(34, 211, 238, 0.1);
	color: var(--text-info-soft);
	font-family: var(--font-mono);
	font-size: 0.78rem;
	font-weight: 800;
	line-height: 1;
	letter-spacing: 0;
	box-shadow: inset 0 -2px 0 rgba(34, 211, 238, 0.16);
}

css authenticated_title() {
	margin: 0;
	font-size: 1.25rem;
	line-height: 1.1;
}

css authenticated_subtitle() {
	margin: 0;
	color: var(--muted);
	font-size: 0.85rem;
}

css authenticated_nav_list() {
	margin: 0;
	padding: 0;
	list-style: none;
	display: flex;
	align-items: center;
	gap: 8px;
}

css authenticated_nav_link() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	padding: 0.45rem 0.7rem;
	border: 1px solid var(--border);
	border-radius: 9px 4px 9px 4px;
	color: var(--text-neutral-soft);
	text-decoration: none;
	font-size: 0.9rem;
	font-weight: 600;
	transition: background-color 120ms ease, border-color 120ms ease, color 120ms ease, box-shadow 120ms ease;
}

css authenticated_nav_link_active() {
	border-color: rgba(34, 211, 238, 0.5);
	background: rgba(34, 211, 238, 0.12);
	color: var(--text-info-soft);
	box-shadow: inset 0 -2px 0 rgba(34, 211, 238, 0.58);
}

css authenticated_profile() {
	display: inline-flex;
	align-items: center;
	padding: 0.4rem 0.65rem;
	border: 1px solid var(--border);
	border-radius: var(--radius-pill);
	background: var(--surface-overlay-muted);
}

css authenticated_profile_text() {
	margin: 0;
	color: var(--muted);
	font-size: 0.85rem;
}
