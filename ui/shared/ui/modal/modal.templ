package modal

type ModalProps struct {
	ID        string
	ClassName string
	AriaLabel string
	Open      bool
	CloseHref string
}

templ Modal(props ModalProps) {
	<dialog
		id={ props.ID }
		class={ modal_dialog(), "ui-modal", props.ClassName }
		aria-label={ props.AriaLabel }
		data-modal-open?={ props.Open }
		data-modal-close-href={ props.CloseHref }
	>
		{ children... }
	</dialog>
}

templ Content() {
	<div class={ modal_content() }>
		{ children... }
	</div>
}

templ Title(text string) {
	<h2 class={ modal_title() }>{ text }</h2>
}

templ Actions() {
	<div class={ modal_actions() }>
		{ children... }
	</div>
}

templ Scripts() {
	<script>
		function navigateModalClose(dialog) {
			const href = dialog.dataset.modalCloseHref || "";
			if (href === "") {
				return;
			}
			window.location.href = href;
		}

		function bindModalInteractions(dialog) {
			if (!(dialog instanceof HTMLDialogElement)) {
				return;
			}

			if (dialog.dataset.backdropCloseBound === "true") {
				return;
			}
			dialog.dataset.backdropCloseBound = "true";

			dialog.addEventListener("click", function(event) {
				// Native modal UX: click on backdrop closes dialog.
				if (event.target === dialog) {
					navigateModalClose(dialog);
				}
			});

			dialog.addEventListener("cancel", function(event) {
				if ((dialog.dataset.modalCloseHref || "") === "") {
					return;
				}
				event.preventDefault();
				navigateModalClose(dialog);
			});

		}

		document.querySelectorAll("dialog.ui-modal").forEach(bindModalInteractions);

		document.addEventListener("htmx:beforeSwap", function(event) {
			if (!event.detail || event.detail.target !== document.getElementById("app-content")) {
				return;
			}
			document.querySelectorAll("dialog.ui-modal[open]").forEach(function(dialog) {
				dialog.close();
			});
		});

		function openModalDialog(dialogId) {
			const dialog = document.getElementById(dialogId);
			bindModalInteractions(dialog);
			if (dialog && typeof dialog.showModal === "function") {
				dialog.showModal();
			}
		}

		function closeModalDialog(dialogId) {
			const dialog = document.getElementById(dialogId);
			if (dialog && typeof dialog.close === "function") {
				dialog.close();
			}
		}

		document.querySelectorAll("dialog.ui-modal[data-modal-open]").forEach(function(dialog) {
			openModalDialog(dialog.id);
		});
	</script>
}
