package dashboard_hosts_ui

func CSSClasses() []templ.CSSClass {
	return []templ.CSSClass{
		dashboard_hosts(),
		dashboard_hosts_header(),
		dashboard_hosts_title(),
		dashboard_hosts_count(),
		dashboard_hosts_empty(),
		dashboard_hosts_list(),
		dashboard_hosts_item(),
		dashboard_hosts_item_header(),
		dashboard_hosts_identity(),
		dashboard_hosts_name(),
		dashboard_hosts_ip(),
		dashboard_hosts_ip_disclosure(),
		dashboard_hosts_ip_toggle(),
		dashboard_hosts_ip_toggle_icon(),
		dashboard_hosts_ip_masked(),
		dashboard_hosts_meta(),
		dashboard_hosts_metrics(),
		dashboard_hosts_metric(),
		dashboard_hosts_metric_label(),
		dashboard_hosts_metric_value(),
		dashboard_hosts_tags(),
	}
}

css dashboard_hosts() {
	display: flex;
	flex-direction: column;
	gap: 10px;
}

css dashboard_hosts_header() {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 10px;
	padding-inline: 12px;
}

css dashboard_hosts_title() {
	margin: 0;
	font-size: 1.05rem;
	line-height: 1.25;
}

css dashboard_hosts_count() {
	color: var(--muted);
	font-size: 0.84rem;
}

css dashboard_hosts_empty() {
	margin: 0;
	color: var(--muted);
}

css dashboard_hosts_list() {
	margin: 0;
	padding: 0;
	list-style: none;
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
	grid-auto-rows: 1fr;
	gap: 12px;
}

css dashboard_hosts_item() {
	min-width: 0;
	display: grid;
}

css dashboard_hosts_item_header() {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 10px;
}

css dashboard_hosts_identity() {
	min-width: 0;
}

css dashboard_hosts_name() {
	margin: 0;
	font-size: 1rem;
	line-height: 1.25;
	overflow-wrap: anywhere;
}

css dashboard_hosts_ip() {
	color: var(--muted);
	font-size: 0.84rem;
	word-break: break-word;
}

css dashboard_hosts_ip_disclosure() {
	display: inline-flex;
	flex-direction: row-reverse;
	align-items: center;
	gap: 10px;
	margin-top: 4px;
	max-width: 100%;
}

css dashboard_hosts_ip_toggle() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 30px;
	height: 30px;
	padding: 0;
	border: none;
	border-radius: var(--radius-pill);
	color: var(--text);
	background: transparent;
	line-height: 1;
	cursor: pointer;
	user-select: none;
}

css dashboard_hosts_ip_toggle_icon() {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	color: currentColor;
}

css dashboard_hosts_ip_masked() {
	display: inline-flex;
	min-height: 1.35em;
	padding: 1px 4px;
	border-radius: var(--radius-xs);
	color: transparent;
	text-shadow: var(--shadow-sensitive-text);
	background: var(--surface-sensitive-mask);
	filter: blur(var(--blur-sensitive));
	user-select: none;
}

css dashboard_hosts_meta() {
	display: flex;
	flex-wrap: wrap;
	gap: 6px 12px;
	margin-top: 10px;
	color: var(--muted);
	font-size: 0.82rem;
}

css dashboard_hosts_metrics() {
	display: grid;
	grid-template-columns: repeat(2, minmax(0, 1fr));
	gap: 8px;
	margin: 12px 0 0;
	padding: 0;
}

css dashboard_hosts_metric() {
	min-width: 0;
	min-height: 66px;
	box-sizing: border-box;
	padding: 8px;
	border: 1px solid var(--border);
	border-radius: var(--radius-md);
	background: var(--surface-overlay-muted);
}

css dashboard_hosts_metric_summary() {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 8px;
	min-width: 0;
}

css dashboard_hosts_metric_label() {
	margin: 0;
	color: var(--muted);
	font-size: 0.78rem;
	line-height: 1.3;
}

css dashboard_hosts_metric_compact_value() {
	margin: 0;
	color: var(--text);
	font-size: 0.84rem;
	line-height: 1.35;
	text-align: right;
	font-variant-numeric: tabular-nums;
	max-width: 68%;
	overflow-wrap: anywhere;
}

css dashboard_hosts_metric_value() {
	margin: 4px 0 0;
	color: var(--text);
	font-size: 0.84rem;
	line-height: 1.35;
	overflow-wrap: anywhere;
}

css dashboard_hosts_sparkline_shell() {
	display: grid;
	grid-template-columns: 28px minmax(0, 1fr);
	align-items: stretch;
	gap: 6px;
	height: 32px;
	margin-top: 7px;
}

css dashboard_hosts_sparkline_scale() {
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	color: var(--muted);
	font-size: 0.62rem;
	line-height: 1;
	font-variant-numeric: tabular-nums;
	text-align: right;
}

css dashboard_hosts_sparkline() {
	display: block;
	width: 100%;
	height: 32px;
	color: var(--primary);
}

css dashboard_hosts_sparkline_cpu() {
	color: var(--primary);
}

css dashboard_hosts_sparkline_memory() {
	color: var(--success);
}

css dashboard_hosts_sparkline_rule() {
	stroke: rgba(255, 255, 255, 0.13);
	stroke-width: 1;
	vector-effect: non-scaling-stroke;
}

css dashboard_hosts_sparkline_mid_rule() {
	stroke: rgba(255, 255, 255, 0.06);
	stroke-width: 1;
	vector-effect: non-scaling-stroke;
}

css dashboard_hosts_sparkline_line() {
	fill: none;
	stroke: currentColor;
	stroke-width: 2;
	stroke-linecap: round;
	stroke-linejoin: round;
	vector-effect: non-scaling-stroke;
}

css dashboard_hosts_tags() {
	display: flex;
	flex-wrap: wrap;
	gap: 7px;
	margin-top: 12px;
}
